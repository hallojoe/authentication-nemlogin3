{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "saml": {
        "ClusterId": "saml",
        "Match": {
          "Hosts": [
            "samlcasko0001.dev.localhost"
          ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "saml": {
        "Destinations": {
          "default": {
            "Address": "https://localhost:44801/"
          }
        }
      }
    }
  }
}
