<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>
  <body>

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Casko.Authentication.Nemlogin3.Web.UI</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Home" asp-action="Secure">Secure Page</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="IdPInitiated" asp-action="Initiate">IdP Initiated</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Metadata" asp-action="Index">Metadata</a>
        </li>
      </ul>

    </div>
  </div>
</nav>

    <main class="container">
        <partial name="_LoginPartial" />    

        @RenderBody()
    </main>

    <footer class="">
        <div class="container">
            <p>&copy; @DateTime.Now.Year. Casko.Authentication.NemLogin3.Web.UI</p>
        </div>
    </footer>

  </body>
</html>
